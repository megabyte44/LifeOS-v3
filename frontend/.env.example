# LifeOS Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===================================
# FIREBASE CLIENT SDK (REQUIRED)
# ===================================
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ===================================
# FIREBASE ADMIN SDK (REQUIRED FOR API ROUTES)
# ===================================
# Option 1: Use individual env vars (recommended for deployment)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Option 2: Or use JSON service account (alternative)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# ===================================
# AI API KEYS (AT LEAST ONE REQUIRED)
# ===================================
# OpenRouter API Key (for Grok and other models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Google Gemini API Key (for Gemini models)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (for GPT models)
# OPENAI_API_KEY=your_openai_api_key_here

# ===================================
# PUSH NOTIFICATIONS (OPTIONAL)
# ===================================
# Get VAPID keys from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:your-email@example.com

# ===================================
# CRON JOB AUTHENTICATION (REQUIRED FOR SCHEDULED TASKS)
# ===================================
# Generate a secure random string for cron job endpoints
CRON_SECRET=your_secure_random_string_here

# ===================================
# DEPLOYMENT CONFIGURATION (OPTIONAL)
# ===================================
# Set to 'production' when deploying
# NODE_ENV=production

# Your site URL for OpenRouter rankings (optional)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===================================
# BACKEND API CONFIGURATION (REQUIRED)
# ===================================
# Base URL for the backend API server (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to 'true' to use mock/placeholder data instead of real API calls.
# Useful for frontend-only development when no backend is running.
NEXT_PUBLIC_USE_MOCK_API=true
