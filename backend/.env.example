# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ──
POSTGRES_DB=lifeos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ── Host port mapping (optional) ──
DB_PORT_HOST=5432
BACKEND_PORT_HOST=8000

# ── Encryption (AES-256-GCM key) ──
ENCRYPTION_SECRET_KEY=CHANGE_ME

# ── VAPID Web Push ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── OpenAI ──
OPENAI_API_KEY=

# ── AI Provider override (comment out to use auto-detection) ──
# Options: openai | gemini | openrouter
AI_PROVIDER=gemini

# ── Google Gemini (free tier: https://aistudio.google.com/app/apikey) ──
GEMINI_API_KEY=

# ── OpenRouter (free models available: https://openrouter.ai/keys) ──
OPENROUTER_API_KEY=

# ── Firebase Admin (required in cloud) ──
# Option 1: full JSON service account as one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 1b: base64-encoded full JSON (useful if your platform mangles JSON secrets)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option 2: individual fields
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep escaped newlines as \n when storing in env/secret managers
FIREBASE_ADMIN_PRIVATE_KEY=
