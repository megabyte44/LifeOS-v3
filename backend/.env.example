# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ──
POSTGRES_DB=lifeos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ── Host port mapping (optional) ──
DB_PORT_HOST=5432
BACKEND_PORT_HOST=8000

# ── Encryption (AES-256-GCM key) ──
ENCRYPTION_SECRET_KEY=CHANGE_ME

# ── VAPID Web Push ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── OpenAI ──
OPENAI_API_KEY=
